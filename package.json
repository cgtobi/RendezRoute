{
  "name": "rendezroute",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted app for advertising a planned run or ride so others can join",
  "license": "AGPL-3.0-only",
  "bin": {
    "rendezroute": "dist/cli.js"
  },
  "type": "module",
  "scripts": {
    "build": "vp build && tsc -p tsconfig.build.json",
    "start": "node dist/cli.js serve",
    "dev": "vpx --watch src/cli.ts serve",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/client",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "test": "vp test",
    "check": "vp check --deny-warnings && npm run typecheck && vp test",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "icons": "node scripts/brand-icons.ts",
    "zones": "node scripts/zone-centres.ts"
  },
  "dependencies": {
    "@fedify/fedify": "2.4.5",
    "@fedify/hono": "2.4.5",
    "@fontsource/inter": "5.3.0",
    "@hono/node-server": "2.1.6",
    "@resvg/resvg-js": "2.6.2",
    "@tmcw/togeojson": "7.1.3",
    "@xmldom/xmldom": "0.9.12",
    "better-sqlite3": "13.0.3",
    "fflate": "0.8.3",
    "hono": "4.13.17",
    "kysely": "0.29.8",
    "leaflet": "1.9.4",
    "nodemailer": "10.2.1",
    "openid-client": "6.8.8",
    "satori": "0.63.2",
    "undici": "8.12.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/smtp-server": "3.5.13",
    "smtp-server": "3.21.1",
    "typescript": "7.0.2",
    "vite-plus": "1.5.0",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=26"
  },
  "volta": {
    "node": "26.13.0"
  },
  "allowScripts": {
    "fsevents": false,
    "better-sqlite3": false
  }
}
