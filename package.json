{
  "name": "rendezroute",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted app for advertising a planned run or ride so others can join",
  "license": "AGPL-3.0-only",
  "bin": {
    "rendezroute": "dist/cli.js"
  },
  "type": "module",
  "scripts": {
    "build": "vp build && tsc -p tsconfig.build.json",
    "start": "node dist/cli.js serve",
    "dev": "vpx --watch src/cli.ts serve",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/client",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "test": "vp test",
    "check": "vp check --deny-warnings && npm run typecheck && vp test"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "@tmcw/togeojson": "7.1.3",
    "@xmldom/xmldom": "0.9.12",
    "better-sqlite3": "13.0.3",
    "hono": "4.13.17",
    "kysely": "0.29.8",
    "leaflet": "1.9.4",
    "undici": "8.12.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vite-plus": "1.5.0"
  },
  "engines": {
    "node": ">=26"
  },
  "volta": {
    "node": "26.13.0"
  },
  "allowScripts": {
    "fsevents": false,
    "better-sqlite3": false
  }
}
